#!name=G1 ACQ SKU Manager - Shadowrocket v7.11.1 Route Fix
#!desc=Self-hosted v7.11.1 fix for /ai, /u/N/ai routing. Original mapping editor and SKU report retained.
#!system=ios

[Rule]
# Force compatible HTTP/3 traffic to TCP for HTTPS MITM inspection.
# NOTE: this rule can affect other apps using UDP/443.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/nguyendp911/loon/main/g1-acq-v7.11.1/g1-acq-discount.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/nguyendp911/loon/main/g1-acq-v7.11.1/g1-sku-report-discount.js

[MITM]
hostname = %APPEND% one.google.com
