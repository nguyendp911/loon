#!name=G1 ACQ SKU Manager v7.11.0 (Mirror)
#!desc=Self-hosted mirror of crhywun/g1-acq v7.11.0; fixes missing @v7.11.0 tag for scripts.
#!system=ios

[Rule]
# Like upstream: block QUIC to allow compatible HTTPS connections to fall back to TCP.
# WARNING: UDP/443 rule affects all apps while this module is enabled.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/nguyendp911/loon/main/g1-acq-v7.11/g1-acq-discount.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/nguyendp911/loon/main/g1-acq-v7.11/g1-sku-report-discount.js

[MITM]
hostname = %APPEND% one.google.com
