#!name=G1 ACQ - Shadowrocket v2.0
#!desc=Google One /ai SKU mapping, self-hosted JS; includes /u/1/ai routing and logs
#!system=ios

[Rule]
# Like original Loon plugin: block QUIC (UDP/443) to allow HTTPS interception.
# WARNING: this affects HTTP/3 traffic for all applications while enabled.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/(?:u\/[0-9]+\/)?ai(?:[\/?#]|$),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/nguyendp911/loon/main/g1-acq-shadowrocket.js

[MITM]
hostname = %APPEND% one.google.com
